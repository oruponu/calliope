# Checks that every project include under SOURCE_DIR goes in a direction that RULES allows. RULES sets
# LAYER_<layer> and FOLDER_<folder> to the layers or folders their files may include from other layers or other
# folders of the same layer. Every layer needs a rule, and so does every subfolder of a layer that has folder rules;
# files may not sit directly under SOURCE_DIR. Project includes are written from SOURCE_DIR, never from the file.
cmake_minimum_required(VERSION 3.22)

if(NOT DEFINED SOURCE_DIR OR NOT DEFINED RULES)
    message(FATAL_ERROR "usage: cmake -DSOURCE_DIR=<dir> -DRULES=<file> -P CheckIncludeDirections.cmake")
endif()

include(${RULES})

file(GLOB_RECURSE files RELATIVE ${SOURCE_DIR} ${SOURCE_DIR}/*.h ${SOURCE_DIR}/*.cpp ${SOURCE_DIR}/*.mm)
if(NOT files)
    message(FATAL_ERROR "no source files under ${SOURCE_DIR}")
endif()

set(violationCount 0)
macro(report text)
    message("${text}")
    math(EXPR violationCount "${violationCount} + 1")
endmacro()

file(GLOB children RELATIVE ${SOURCE_DIR} ${SOURCE_DIR}/*)
get_cmake_property(ruleNames VARIABLES)
set(layersWithFolderRules "")
foreach(child IN LISTS children)
    if(NOT IS_DIRECTORY ${SOURCE_DIR}/${child})
        continue()
    endif()
    if(NOT DEFINED LAYER_${child})
        report("layer without a rule: ${child}")
    endif()
    foreach(name IN LISTS ruleNames)
        if(name MATCHES "^FOLDER_${child}/")
            list(APPEND layersWithFolderRules ${child})
            break()
        endif()
    endforeach()
endforeach()

set(includePattern "^[ \t]*#[ \t]*include[ \t]*[<\"]([^\">]+)[\">]")
set(unruledFolders "")
foreach(file IN LISTS files)
    get_filename_component(folder ${file} DIRECTORY)
    if(folder STREQUAL "")
        report("file outside every layer: ${file}")
        continue()
    endif()
    string(REGEX REPLACE "/.*" "" layer ${folder})
    if(NOT folder STREQUAL layer AND layer IN_LIST layersWithFolderRules AND NOT DEFINED FOLDER_${folder}
       AND NOT folder IN_LIST unruledFolders)
        list(APPEND unruledFolders ${folder})
        report("folder without a rule: ${folder}")
    endif()

    file(STRINGS ${SOURCE_DIR}/${file} lines REGEX "${includePattern}")
    foreach(line IN LISTS lines)
        string(REGEX MATCH "${includePattern}" unused "${line}")
        set(path ${CMAKE_MATCH_1})
        string(REGEX REPLACE "/.*" "" targetLayer ${path})
        if(targetLayer STREQUAL path OR NOT IS_DIRECTORY ${SOURCE_DIR}/${targetLayer})
            # Found next to the including file: the compiler accepts it, but it hides the direction from this check.
            if(EXISTS ${SOURCE_DIR}/${folder}/${path})
                report("include path violation: ${file} includes \"${path}\" (relative to the including file)")
            endif()
            # Otherwise a system, library, or generated header.
            continue()
        endif()
        get_filename_component(targetFolder ${path} DIRECTORY)

        set(allowed TRUE)
        if(NOT targetLayer STREQUAL layer)
            if(DEFINED LAYER_${layer} AND NOT targetLayer IN_LIST LAYER_${layer})
                set(allowed FALSE)
            endif()
        elseif(NOT targetFolder STREQUAL folder AND DEFINED FOLDER_${folder})
            if(NOT targetFolder IN_LIST FOLDER_${folder})
                set(allowed FALSE)
            endif()
        endif()

        if(NOT allowed)
            report("include direction violation: ${file} includes \"${path}\" (${folder} -> ${targetFolder})")
        endif()
    endforeach()
endforeach()

if(violationCount GREATER 0)
    message(FATAL_ERROR "${violationCount} include direction violations")
endif()
